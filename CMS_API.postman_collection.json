          }
        },
        {
          "name": "Create Case",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "if (res.result && res.result.id) {",
                  "    pm.collectionVariables.set('case_id', res.result.id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"business_id\": 1,\n    \"customer_code\": \"AH091Y\",\n    \"depot_id\": 1,\n    \"accused_name\": \"Md. Rafiqul Islam\",\n    \"accused_address\": \"Mirpur 10, Dhaka\",\n    \"petitioner_name\": \"ACI Limited\",\n    \"lawyer_name\": \"Advocate Md. Karim\",\n    \"case_number\": \"CMS-2026-101\",\n    \"section\": \"138 NI Act\",\n    \"court_id\": 1,\n    \"is_case_filed\": true,\n    \"case_filing_date\": \"2026-07-20\",\n    \"cheque_amount\": 400000,\n    \"remarks\": \"Optional notes\",\n\n    \"dues_at_filing\": 400000,\n    \"dues_at_25th_previous_month\": 350000,\n    \"dues_at_25th_current_month\": 300000,\n\n    \"status_id\": 2,\n    \"previous_hearing_date\": null,\n    \"next_hearing_date\": \"2026-08-15\",\n    \"legal_notice_served_date\": null,\n    \"contact_phone\": \"01711000000\",\n    \"contact_email\": \"customer@example.com\",\n    \"guarantor_name\": \"Rahim Mia\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/cases", "host": ["{{base_url}}"], "path": ["api", "cases"] },
            "description": "customer_code / lawyer_name are free text — a row is created on first sight. Send customer_code_id / lawyer_id instead if you already have them.\n\nrecovered_notice_to_date, total_recovered_amount and present_dues are DERIVED server-side from the three dues values — do not send them."
          }
        },
        {
          "name": "Case Details",
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": { "raw": "{{base_url}}/api/cases/{{case_id}}", "host": ["{{base_url}}"], "path": ["api", "cases", "{{case_id}}"] },
