                { "key": "date_from", "value": "2024-01-01", "disabled": true },
                { "key": "date_to", "value": "2026-12-31", "disabled": true }
              ]
            },
            "description": "summary, case_aging, depot_wise_recovery_rate, depot_performance, key_performance_indicators."
          }
