              "mode": "raw",
              "raw": "{\n    \"business_id\": 1,\n    \"customer_code\": \"AH091Y\",\n    \"depot_id\": 1,\n    \"accused_name\": \"Md. Rafiqul Islam\",\n    \"accused_address\": \"Mirpur 10, Dhaka\",\n    \"petitioner_name\": \"ACI Limited\",\n    \"lawyer_id\": 1,\n    \"case_number\": \"CMS-2026-101\",\n    \"section\": \"138 NI Act\",\n    \"court_id\": 1,\n    \"is_case_filed\": true,\n    \"case_filing_date\": \"2026-07-20\",\n    \"cheque_amount\": 400000,\n    \"remarks\": \"Updated notes\",\n    \"judgement_details\": \"Judgement in favour of petitioner\",\n\n    \"dues_at_filing\": 400000,\n    \"dues_at_25th_previous_month\": 350000,\n    \"dues_at_25th_current_month\": 250000,\n\n    \"status_id\": 5,\n    \"next_hearing_date\": \"2026-09-15\"\n}"
            },
            "url": { "raw": "{{base_url}}/api/cases/{{case_id}}", "host": ["{{base_url}}"], "path": ["api", "cases", "{{case_id}}"] }
