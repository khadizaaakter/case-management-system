<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /case-management-system/

    # If the request is a real file or directory, serve it directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, send everything to index.html (SPA client-side routing)
    RewriteRule ^ index.html [L]
</IfModule>
